# ════════════════════════════════════════════════════════
# Realtouch Financial ERP — Environment Configuration
# Copy to .env and fill in your values
# NEVER commit .env to version control
# ════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────
APP_NAME="Realtouch Financial ERP"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true

# ── Security ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-minimum-32-characters-change-this-now
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database (PostgreSQL / Supabase) ─────────────────────
# Local:
DATABASE_URL=postgresql://postgres:password@localhost:5432/realtouch_erp
# Supabase:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis & Celery ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Supabase Storage ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=receipts

# ── AWS S3 (alternative to Supabase) ─────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=realtouch-receipts
# AWS_REGION=eu-west-2

# ── AI ────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Get from: https://platform.openai.com/
OPENAI_API_KEY=sk-your-openai-key-here
AI_MODEL=claude-sonnet-4-20250514

# ── Stripe ───────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Frontend:
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# ── PayPal ────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# ── Email (SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=finance@harvesttouch.org.uk
SMTP_PASSWORD=your-app-password

# ── HMRC ─────────────────────────────────────────────────
HMRC_PAYE_REFERENCE=123/AB12345
# HMRC_GATEWAY_USER=
# HMRC_GATEWAY_PASSWORD=

# ── Organisation ─────────────────────────────────────────
DEFAULT_ORG_NAME="Harvest Touch Youth & Skills Community Hub CIC"
DEFAULT_CURRENCY=GBP
DEFAULT_TAX_YEAR_START=04-06
DEFAULT_TENANT_SLUG=harvest-touch
MULTI_TENANT=true

# ── Frontend (Next.js) ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Docker ───────────────────────────────────────────────
POSTGRES_PASSWORD=your-postgres-password
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_ORIGIN_REGEX=https://.*\.(onrender\.com|vercel\.app)
